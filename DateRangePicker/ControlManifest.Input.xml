<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <!--
    The version here is what the Power Platform upgrades on, and the release
    workflow refuses to publish a tag that disagrees with it. Bump this in the
    same commit as the tag.
  -->
  <control namespace="PCFHub"
           constructor="DateRangePicker"
           version="0.3.1"
           display-name-key="DateRangePicker_Name"
           description-key="DateRangePicker_Desc"
           control-type="virtual">

    <!--
      Nothing here leaves the browser: no WebAPI, no device, no third-party
      service. That is also what makes the hub demo `full` fidelity.
    -->
    <external-service-usage enabled="false" />

    <!--
      TWO bound properties, which is deliberate and is the exception to the
      usual rule rather than a lapse from it.

      The rule exists because a field control binds its *first* bound property
      to the column it is placed on and renders every additional one as its own
      column picker in the maker's configuration pane. For a control that
      attaches to one column that second picker is a wrong question, which is
      why pcf-choices-picker reverted to a single type-grouped property.

      A date range genuinely is two columns. Placed on the start date, being
      asked which column holds the end date is the only way for a maker to
      express the thing — so here the second picker is the feature.

      startDate is declared first because that is the column the control
      attaches to.

      Both are type-grouped from 0.3.0 rather than fixed to DateOnly, so the
      control can also be placed on a Date and Time column. It does NOT cost
      what pcf-choices-picker's group cost: refreshTypes still emits
      DateTimeProperty for both, because every member of this group is in the
      DateAndTime family. The base-`Property` fallback — `raw: any`,
      `attributes: Metadata` — is what a group across families gets.

      Measured on a live form on 2026-09-12 (the 0.2.7 probe build): a
      control already bound to two Date Only columns stays bound through the
      upgrade; the control is offered on a Date and Time column and the End
      picker offers Date and Time columns; `property.type` reports the member
      the column resolved to, and `attributes.Format` is 'date' or 'datetime'.
      Whether the End picker also offers a Date Only column beside a Date and
      Time start is still unobserved — the control handles the pair either way.
    -->
    <type-group name="dateColumn">
      <type>DateAndTime.DateOnly</type>
      <type>DateAndTime.DateAndTime</type>
    </type-group>

    <property name="startDate"
              display-name-key="startDate_Name"
              description-key="startDate_Desc"
              of-type-group="dateColumn"
              usage="bound"
              required="true" />

    <property name="endDate"
              display-name-key="endDate_Name"
              description-key="endDate_Desc"
              of-type-group="dateColumn"
              usage="bound"
              required="true" />

    <!--
      Outer bounds, optional. Typed as real dates rather than as text so a
      canvas maker can bind a formula such as Today() instead of hand-typing a
      format the control would then have to parse.
    -->
    <property name="minDate"
              display-name-key="minDate_Name"
              description-key="minDate_Desc"
              of-type="DateAndTime.DateOnly"
              usage="input"
              required="false" />

    <property name="maxDate"
              display-name-key="maxDate_Name"
              description-key="maxDate_Desc"
              of-type="DateAndTime.DateOnly"
              usage="input"
              required="false" />

    <!--
      The pair rules and the duration line, as Enums rather than as TwoOptions.

      Both of these read as "on by default" and neither could be. `refreshTypes`
      generates TwoOptionsProperty with `raw: boolean` — not `boolean | null` —
      so there is no value meaning "the maker never touched this", and a maker
      who does not touch it gets `false`. `default-value="true"` does not close
      that gap: v0.1.x declared exactly that and shipped a control that blocked
      same-day ranges and hid the duration by default, contradicting its own
      descriptions.

      An Enum carries a real default-value and generates a string union, so the
      default is the one the documentation always claimed. The alternative was
      inverting both names to blockSameDay and hideDuration, which is honest and
      reads worse.
    -->
    <property name="sameDay"
              display-name-key="sameDay_Name"
              description-key="sameDay_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="allow">
      <value name="allow" display-name-key="sameDay_Allow">allow</value>
      <value name="block" display-name-key="sameDay_Block">block</value>
    </property>

    <property name="duration"
              display-name-key="duration_Name"
              description-key="duration_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="show">
      <value name="show" display-name-key="duration_Show">show</value>
      <value name="hide" display-name-key="duration_Hide">hide</value>
    </property>

    <!--
      Whether the picker offers a time beside each date.

      `auto` follows the bound column: a Date and Time column gets a time box,
      a Date Only column does not — read off `attributes.Format`, which a
      model-driven form supplies and canvas does not. On canvas there is no
      column, so `auto` means no times and a maker who wants them says `show`.
      `hide` keeps a Date and Time column to whole days, written at midday.

      An Enum rather than a TwoOptions for the reason the two above are: only
      an Enum can carry a real "the maker never touched this" default, and
      "follow the column" is exactly that state.
    -->
    <property name="time"
              display-name-key="time_Name"
              description-key="time_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="auto">
      <value name="auto" display-name-key="time_Auto">auto</value>
      <value name="show" display-name-key="time_Show">show</value>
      <value name="hide" display-name-key="time_Hide">hide</value>
    </property>

    <!--
      Which quick ranges the picker offers, as a comma-separated list of tokens:
      today, last7, last30, thisWeek, thisMonth, lastMonth, thisYear, next7,
      next30, nextMonth.

      Text rather than an Enum because a maker picks several, and text rather
      than ten booleans because ten properties for one rail is a configuration
      pane nobody reads. Unknown tokens are ignored rather than failing — a
      canvas formula can supply anything, and a typo should cost one button
      rather than the whole control. An empty string means no rail at all.

      The default mixes past- and future-facing shortcuts on purpose: the same
      control records a booking window and reports on a period already elapsed.
    -->
    <property name="presets"
              display-name-key="presets_Name"
              description-key="presets_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false"
              default-value="today,last7,last30,thisMonth,next7,next30" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/DateRangePicker.css" order="1" />
      <resx path="strings/DateRangePicker.1033.resx" version="1.0.0" />
      <resx path="strings/DateRangePicker.1031.resx" version="1.0.0" />
      <resx path="strings/DateRangePicker.1036.resx" version="1.0.0" />
      <resx path="strings/DateRangePicker.1041.resx" version="1.0.0" />
      <resx path="strings/DateRangePicker.3082.resx" version="1.0.0" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>

    <!--
      No <feature-usage>: the control reads context.mode, context.userSettings,
      context.formatting and context.resources, none of which are gated.
    -->
  </control>
</manifest>
